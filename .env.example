# Public browser map style key. Create one at https://cloud.maptiler.com/ and restrict it
# to the production web domain before release. This is intentionally a publishable key.
EXPO_PUBLIC_MAPTILER_KEY=

# Set production on Vercel to disable all demo records and use cloud data.
EXPO_PUBLIC_DATA_MODE=development
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
